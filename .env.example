# Gravity Claw — Environment Variables
# Copy this file to .env and fill in your values.

# === LLM Providers (at least one required) ===
GEMINI_API_KEY=your-gemini-api-key
KIMI_API_KEY=your-kimi-api-key

# === Telegram Bridge (optional) ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_USER_IDS=12345,67890

# === MCP Gateway (optional) ===
MCP_GATEWAY_URL=http://localhost:3100
MCP_GATEWAY_NODE_PATH=
MCP_GATEWAY_PYTHON_PATH=

# === Server Configuration ===
GRAVITY_CLAW_PORT=5187
PORT=5187
GRAVITY_CLAW_CONFIG_PATH=
GRAVITY_CLAW_NODE_PATH=

# === API Authentication (optional but recommended) ===
# If set, all API routes (except /api/health) require:
#   Authorization: Bearer <GRAVITY_CLAW_API_SECRET>
GRAVITY_CLAW_API_SECRET=

# === Frontend Build Overrides ===
VITE_GRAVITY_CLAW_API_BASE=
VITE_GRAVITY_CLAW_PORT=5177
VITE_ENABLE_DEV_BYPASS=false
