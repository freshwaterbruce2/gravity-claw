{
  "name": "gravity-claw",
  "version": "0.2.0",
  "description": "AI agent orchestrator desktop application",
  "author": "Bruce Freshwater",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5177",
    "server": "tsx server/src/index.ts",
    "server:dev": "tsx watch server/src/index.ts",
    "start": "concurrently \"pnpm dev\" \"pnpm server:dev\" --names \"ui,api\" --prefix-colors \"yellow,cyan\"",
    "start:full": "concurrently \"pnpm dev\" \"pnpm server:dev\" \"node --import tsx ../../apps/mcp-gateway/src/index.ts\" \"wait-on http://localhost:5187/api/inngest && pnpm inngest:dev\" --names \"ui,api,mcp,inngest\" --prefix-colors \"yellow,cyan,green,magenta\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "desktop:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build": "pnpm run typecheck && pnpm run typecheck:server && vite build && pnpm run build:server",
    "preview": "vite preview",
    "test": "node --import tsx --experimental-test-coverage --test src/**/*.test.ts server/**/*.test.ts scripts/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "lint": "eslint . --ext ts,tsx",
    "self-improve": "powershell -ExecutionPolicy Bypass -File scripts/apply-improvement.ps1",
    "inngest:dev": "node scripts/start-inngest-dev.mjs",
    "build:server": "node scripts/bundle-server.mjs",
    "build:desktop": "scripts/build-desktop.bat",
    "build:desktop:signed": "echo Run scripts/build-desktop-signed.bat to build with update signing"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.13.7",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@vibetech/inngest-client": "workspace:*",
    "dotenv": "^16.4.7",
    "hono": "^4.7.7",
    "inngest": "^3.52.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "telegraf": "^4.16.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.2",
    "esbuild": "0.27.3",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "wait-on": "^7.2.0",
    "typescript-eslint": "^8.31.0",
    "vite": "^7.3.1"
  }
}
