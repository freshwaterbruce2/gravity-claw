{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    /* "noUncheckedIndexedAccess": true, // VibeTech standard — enable after fixing capability-policy.ts, history.ts, index.ts, tasks.ts, telegram.test.ts */
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
